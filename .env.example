# Copy to .env next to .autoreg/config.yaml (or export the variables).
# The pack expands ${VAR} in config.yaml only.

# --- Fernet key (optional; otherwise .autoreg/key is generated) -------------
# AUTOREG_FERNET_KEY=

# --- Cloudflare temp email (operator Worker contract) ----------------------
# TEMPMAIL_BASE=https://temp-email-worker.example.workers.dev
# TEMPMAIL_ADMIN_KEY=
# TEMPMAIL_DOMAIN=

# --- mail.tm needs no credentials ------------------------------------------

# --- Outlook Graph ----------------------------------------------------------
# OUTLOOK_EMAIL=
# OUTLOOK_CLIENT_ID=
# OUTLOOK_REFRESH_TOKEN=

# --- Generic IMAP -----------------------------------------------------------
# IMAP_HOST=imap.example.com
# IMAP_USER=
# IMAP_PASSWORD=

# --- CAPTCHA ----------------------------------------------------------------
# TWOCAPTCHA_KEY=
# YESCAPTCHA_KEY=

# --- Proxies (also can live in config.yaml proxy.pool) ----------------------
# AUTOREG_PROXY=http://user:pass@host:port
